{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booking-planner",
  "main": "worker.js",
  "compatibility_date": "2026-08-16",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_YOUR_D1_DATABASE_NAME",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
